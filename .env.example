# Superuser / migrator connection (local docker-compose)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/abcrm
# Application role (NO BYPASSRLS) — created by packages/db/scripts/dev-roles.sql
APP_DATABASE_URL=postgres://abcrm_app_user:abcrm_app_pw@localhost:5432/abcrm
# Dev-only key material (32 bytes, base64). Production uses KMS.
ABCRM_DEV_MASTER_KEY=
ABCRM_GLOBAL_HMAC_KEY=
# Optional legacy WorkOS SSO. Internal email/password login requires none of these keys.
WORKOS_CLIENT_ID=
# Optional: expected token issuer (depends on your WorkOS auth domain); validated when set.
WORKOS_ISSUER=
# Production key wrapping: select secret for Render secrets, or kms for AWS KMS.
# Store and back up the master key securely; never regenerate it on redeploy.
ABCRM_KEY_PROVIDER=
ABCRM_MASTER_KEY=
# Required only for the kms provider. Dev falls back to ABCRM_DEV_MASTER_KEY.
ABCRM_KMS_KEY_ID=
AWS_REGION=us-east-1
# Worker: global tables (public page cache, crawl politeness, search cache) — abcrm_global member
GLOBAL_DATABASE_URL=postgres://abcrm_global_user:abcrm_global_pw@localhost:5432/abcrm
# Sourcing: web search provider (Brave Search API; provider choice pending the M3 spike)
BRAVE_SEARCH_API_KEY=
# Crawler identity: must name the bot and link to a page explaining it / how to opt out
ABCRM_BOT_UA=ABCRMBot/0.1 (+https://abcrm.app/bot)
ABCRM_FETCH_INTERVAL_MS=2000
# LLM gateway (Claude API). Unset: S1 runs rule-only, Q1 marks AI criteria unknown.
ANTHROPIC_API_KEY=
# Optional tier → model overrides (defaults in packages/llm/src/pricing.ts)
ABCRM_LLM_MODEL_SMALL=
ABCRM_LLM_MODEL_MEDIUM=
ABCRM_LLM_MODEL_LARGE=
# Contact Data Layer platform keys (32 bytes, base64; required in production): global blind index + licensed cache
ABCRM_PLATFORM_HMAC_KEY=
ABCRM_PLATFORM_CACHE_KEY=
# Staff notifications by email (Postmark). Unset: notifications stay in-app, email is skipped.
POSTMARK_SERVER_TOKEN=
NOTIFY_FROM_EMAIL=
# Usage reporting to Stripe Billing Meters. Unset: usage is aggregated hourly and marked skipped.
STRIPE_SECRET_KEY=
# Worker: DBOS system database (defaults to DATABASE_URL)
DBOS_SYSTEM_DATABASE_URL=
# Enables "Authorization: Bearer dev:<tenantId>:<userId>" (never in production)
ABCRM_DEV_AUTH=1
PORT=3000
# Web app (apps/web): API base URL, session cookie key (32 bytes, base64; required in production)
ABCRM_API_URL=http://localhost:3000
ABCRM_WEB_SESSION_SECRET=
# Exact public web origin for form CSRF validation behind a proxy; use HTTPS in production.
ABCRM_PUBLIC_URL=http://localhost:3001
# Optional WorkOS API key for legacy SSO.
WORKOS_API_KEY=
WORKOS_REDIRECT_URI=http://localhost:3001/auth/callback
# Allows dev sign-in on a production build. E2E/CI only, never on a real deployment.
ABCRM_WEB_ALLOW_DEV=
