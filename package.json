{
  "name": "abcrm",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @abcrm/db migrate",
    "db:reset": "pnpm --filter @abcrm/db reset",
    "report:exit-criteria": "pnpm --filter @abcrm/db report",
    "db:rls-check": "pnpm --filter @abcrm/db rls-check",
    "tenant:create": "pnpm --filter @abcrm/db tenant:create",
    "eval": "pnpm --filter @abcrm/evals eval",
    "dev:app": "pnpm --filter @abcrm/app dev",
    "dev:worker": "pnpm --filter @abcrm/worker dev",
    "dev:web": "pnpm --filter @abcrm/web dev"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "fast-check": "4.10.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
